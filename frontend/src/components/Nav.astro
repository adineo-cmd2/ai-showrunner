---
const links: { href: string; label: string }[] = [
  { href: '/', label: 'Title page' },
  { href: '/bible', label: 'Bible' },
  { href: '/episode-editor', label: 'Editor' },
  { href: '/continuity', label: 'Continuity' },
  { href: '/threads', label: 'Threads' },
  { href: '/settings', label: 'Settings' },
];

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const full = href === '/' ? base || '/' : `${base}${href}`;
  return cur === (full.replace(/\/+$/, '') || '/');
};
---
<div class="slip">
  <div class="slip-inner">
    <span>Story department</span>
    <span class="slip-mid">A living story bible · canon gated by the author</span>
    <span>Draft 03 — local</span>
  </div>
</div>
<header class="nav">
  <div class="nav-inner">
    <a href={base || '/'} class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4M9 12h6M9 16h4"/></svg>
      </span>
      <span class="brand-text">
        <span>AI Showrunner</span>
        <small>Writers&rsquo; room</small>
      </span>
    </a>
    <button id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    <nav id="nav-menu" class="nav-menu" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href === '/' ? base || '/' : `${base}${l.href}`}
              data-navlink={l.href}
              class:list={['nav-link', { active: isActive(l.href) }]}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a href={`${base}/`} class="nav-link nav-cta">New series</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
<script>
  // Preserve ?story= across nav when present. Runs in the browser only.
  const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
  const params = new URLSearchParams(window.location.search);
  const story = params.get('story');
  if (story) {
    document.querySelectorAll('[data-navlink]').forEach((a) => {
      const el = a as HTMLAnchorElement;
      const target = el.getAttribute('data-navlink') || '/';
      if (target === '/') return;
      el.href = `${base}${target}?story=${encodeURIComponent(story)}`;
    });
  }
</script>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
