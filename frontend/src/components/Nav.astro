---
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/bible", "label": "Bible"}, {"href": "/episode-editor", "label": "Editor"}, {"href": "/continuity", "label": "Continuity"}, {"href": "/threads", "label": "Threads"}, {"href": "/settings", "label": "Settings"}];

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const full = href === '/' ? base || '/' : `${base}${href}`;
  return cur === (full.replace(/\/+$/, '') || '/');
};
---
<header class="nav">
  <div class="nav-inner">
    <a href={base || '/'} class="brand">
      <span class="brand-mark"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 4v16M17 4v16M2 9h5M2 15h5M17 9h5M17 15h5"/></svg></span>
      <span>AI Showrunner</span>
    </a>
    <button id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    <nav id="nav-menu" class="nav-menu" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href === '/' ? base || '/' : `${base}${l.href}`}
              data-navlink={l.href}
              class:list={['nav-link', { active: isActive(l.href) }]}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li class="hidden md:ml-2 md:inline-flex">
          <a href={`${base}/`} class="nav-link nav-cta">New series</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
<script>
  // Preserve ?story= across nav when present. Runs in the browser only.
  const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
  const params = new URLSearchParams(window.location.search);
  const story = params.get('story');
  if (story) {
    document.querySelectorAll('[data-navlink]').forEach((a) => {
      const el = a as HTMLAnchorElement;
      const target = el.getAttribute('data-navlink') || '/';
      if (target === '/') return;
      el.href = `${base}${target}?story=${encodeURIComponent(story)}`;
    });
  }
</script>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
