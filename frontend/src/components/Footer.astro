---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const year = new Date().getFullYear();
const links: { href: string; label: string }[] = [
  { href: '/', label: 'Title page' },
  { href: '/bible', label: 'Story bible' },
  { href: '/episode-editor', label: 'Episode editor' },
  { href: '/continuity', label: 'Continuity board' },
  { href: '/threads', label: 'Plot threads' },
  { href: '/settings', label: 'Settings' },
];
---
<footer class="footer">
  <div class="footer-grid">
    <div>
      <a href={base || '/'} class="brand" style="margin-bottom: 1rem">
        <span class="brand-mark" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4M9 12h6M9 16h4"/></svg>
        </span>
        <span class="brand-text">
          <span>AI Showrunner</span>
          <small>Writers&rsquo; room</small>
        </span>
      </a>
      <p style="color: #cfc2ab; font-size: 0.9rem; line-height: 1.65; max-width: 34rem">
        You own the story. Episode analysis only proposes bible changes — nothing enters canon until you confirm it.
        Pending changes stay gated until the author signs off.
      </p>
    </div>
    <div>
      <h4>The production</h4>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href === '/' ? base || '/' : `${base}${l.href}`}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Colophon</h4>
      <ul class="footer-links">
        <li><a href="https://github.com/adineo-cmd2/ai-showrunner" target="_blank" rel="noreferrer">Source on GitHub</a></li>
        <li><a href="https://adineo-cmd2.github.io/ai-showrunner/" target="_blank" rel="noreferrer">Public reading copy</a></li>
        <li><span>Local backend · <span class="mono">localhost:8005</span></span></li>
        <li><span>FastAPI · Astro · React</span></li>
        <li><span>Set in Fraunces &amp; Courier Prime</span></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© {year} AI Showrunner · Aditya Yadav</span>
      <span>A local production. Your story stays on your machine.</span>
    </div>
  </div>
</footer>
