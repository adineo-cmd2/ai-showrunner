---
import BaseLayout from "../layouts/BaseLayout.astro";
import IssueTable from "../components/continuity/IssueTable";

const story = Astro.url.searchParams.get('story') ?? '';
---
<BaseLayout title="Continuity">
<h1 class="display-f mb-4 text-2xl text-stone-100">Continuity board</h1>
<form id="pick-story" class="mb-4 flex max-w-xl gap-2">
  <input id="ps-id" class="border border-charcoal-line bg-charcoal px-2 py-1 text-stone-100" placeholder="Story id" inputmode="numeric" value={story} />
  <button class="border border-charcoal-line px-3 py-1 text-sm text-stone-200 hover:border-brand hover:text-brand" type="submit">Load</button>
</form>
{!story && <p class="text-sm text-stone-400">Enter a story id to review its continuity issues.</p>}
{story && <IssueTable client:visible storyId={story} />}
<script>
  document.getElementById('pick-story')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const input = document.getElementById('ps-id') as HTMLInputElement;
    const id = input.value.trim();
    if (id) window.location.href = `/continuity?story=${encodeURIComponent(id)}`;
  });
</script>
</BaseLayout>
