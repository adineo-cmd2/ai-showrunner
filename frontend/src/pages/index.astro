---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---
<BaseLayout
  title="AI Showrunner — the writers’ room that never forgets"
  description="Keep a living story bible — characters, locations, timeline, threads, world rules. Submit an episode and the showrunner extracts new entities, checks continuity, and flags Chekhov guns."
>
<section class="title-page">
  <div class="title-main">
    <p class="slugline">A series bible · one continuous draft</p>
    <h1 class="title">The writers’ room<br /><em>never forgets.</em></h1>
    <p class="title-deck">
      Characters, places, timeline, threads and world rules in one living document. Submit an episode and the
      showrunner extracts new entities, checks continuity and flags Chekhov guns. Nothing enters canon until you
      approve it.
    </p>
    <div class="hero-ctas">
      <a href="#new-series" class="btn btn-accent btn-lg">Start a new series</a>
      <a href="#reopen-series" class="btn btn-ghost btn-lg">Reopen a series</a>
    </div>
  </div>
  <aside class="coverage">
    <div class="coverage-head">
      <span>Coverage</span>
      <span>Prod. 01</span>
    </div>
    <dl>
      <div>
        <dt>Bible</dt>
        <dd>Characters, locations, timeline, threads, rules</dd>
      </div>
      <div>
        <dt>Draft</dt>
        <dd>Episode editor with live consistency warnings</dd>
      </div>
      <div>
        <dt>Coverage</dt>
        <dd>Continuity, contradictions and impossible geography</dd>
      </div>
      <div>
        <dt>Canon</dt>
        <dd>Every change waits for your signature</dd>
      </div>
    </dl>
    <p class="coverage-note">No silent edits. No lost threads. No canon by accident.</p>
  </aside>
</section>

<section class="section">
  <div class="section-head">
    <p class="slugline">Scenes from the room</p>
    <h2 class="section-title">Everything the story needs, in one place.</h2>
  </div>
  <div class="beats">
    <article class="beat">
      <p class="beat-slug">INT. STORY BIBLE — DAY</p>
      <h3>The bible</h3>
      <p>Characters, locations, timeline, threads and world rules. One living document per series, not a drawer of notes.</p>
    </article>
    <article class="beat">
      <p class="beat-slug">INT. EPISODE EDITOR — NIGHT</p>
      <h3>The draft</h3>
      <p>Write episodes with live consistency warnings as you type. The room reads over your shoulder without taking the pen.</p>
    </article>
    <article class="beat">
      <p class="beat-slug">INT. CONTINUITY BOARD — DAY</p>
      <h3>The coverage</h3>
      <p>Broken rules, contradictions and impossible geography, flagged scene by scene before they reach the page.</p>
    </article>
    <article class="beat">
      <p class="beat-slug">INT. THREAD ROOM — LATER</p>
      <h3>The threads</h3>
      <p>Every open plot thread on one board. Plant it, pay it off, or cut it before the audience notices.</p>
    </article>
    <article class="beat">
      <p class="beat-slug">INT. EXTRACTION — CONTINUOUS</p>
      <h3>The new arrivals</h3>
      <p>New characters and places are proposed from your draft. They never walk into canon unannounced.</p>
    </article>
    <article class="beat">
      <p class="beat-slug">INT. CANON GATE — DAWN</p>
      <h3>The signature</h3>
      <p>Pending changes line up for approval. Canon is only what you confirm — the rest stays in the drawer.</p>
    </article>
  </div>
</section>

<section class="section" id="new-series">
  <div class="section-head">
    <p class="slugline">Open a production</p>
    <h2 class="section-title">Start or reopen a series.</h2>
    <p class="lead">Create a bible here, or return to one by its production number. Both forms are live.</p>
  </div>
  <div class="call-sheets">
    <form id="new-bible" class="sheet">
      <div class="sheet-head"><span>Form A — New production</span><span>Required</span></div>
      <h3>Start a new series</h3>
      <p class="sheet-deck">Title, genre, setting and world rules. One rule per line.</p>
      <label class="block"><span class="label-x">Title</span>
        <input id="nb-title" class="input" placeholder="The Salt Meridian" required />
      </label>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <label class="block"><span class="label-x">Genre</span>
          <input id="nb-genre" class="input" placeholder="mystery" />
        </label>
        <label class="block"><span class="label-x">Setting</span>
          <input id="nb-setting" class="input" placeholder="a tidally-locked port city" />
        </label>
      </div>
      <label class="mt-3 block"><span class="label-x">World rules — one per line</span>
        <textarea id="nb-rules" class="textarea mono" placeholder="No faster-than-light travel&#10;The dead stay dead"></textarea>
      </label>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button class="btn btn-accent" type="submit">Create bible</button>
        <p id="nb-msg" class="text-sm" style="color: var(--ink-soft)"></p>
      </div>
    </form>
    <form id="open-bible" class="sheet" style="align-self: start">
      <div class="sheet-head"><span>Form B — Return</span><span>By id</span></div>
      <h3>Reopen a series</h3>
      <p class="sheet-deck">Got a story id from a previous session? Pull the production back into the room.</p>
      <label class="block"><span class="label-x">Story id</span>
        <input id="ob-id" class="input" placeholder="e.g. 14" inputmode="numeric" />
      </label>
      <button class="btn btn-ghost mt-4" type="submit">Open bible</button>
    </form>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <p class="slugline">How the room works</p>
    <h2 class="section-title">Three acts, no filler.</h2>
  </div>
  <div class="acts">
    <div class="act">
      <p class="act-label">Act one</p>
      <h3>Bible the world</h3>
      <p>Characters, places, timeline, threads and rules go on the page before the first scene is written.</p>
    </div>
    <div class="act">
      <p class="act-label">Act two</p>
      <h3>Write the episode</h3>
      <p>The editor checks continuity as you type, so the room catches the break while it is still cheap to fix.</p>
    </div>
    <div class="act">
      <p class="act-label">Act three</p>
      <h3>Sign the canon</h3>
      <p>Every proposed change waits for approval. Confirm it, reject it, or leave it in the pending drawer.</p>
    </div>
  </div>
</section>

<section class="section reveal">
  <div class="production-note">
    <blockquote>
      “You own the story. Episode analysis only proposes bible changes — nothing enters canon until you confirm it.”
    </blockquote>
    <p class="signature">The showrunner’s first rule</p>
  </div>
</section>

<section class="section">
  <div class="end-card reveal">
    <div>
      <p class="slugline">Fade out</p>
      <h2>Roll credits on inconsistency.</h2>
      <p>Bible the world once. Let the showrunner keep it straight.</p>
    </div>
    <a href="#new-series" class="btn btn-accent btn-lg">Create a bible</a>
  </div>
</section>
<script>
  import { apiPost } from '../lib/apiClient';
  const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
  const msg = document.getElementById('nb-msg')!;
  document.getElementById('new-bible')!.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    msg.textContent = 'Creating…';
    const title = (document.getElementById('nb-title') as HTMLInputElement).value.trim();
    const genre = (document.getElementById('nb-genre') as HTMLInputElement).value.trim();
    const setting = (document.getElementById('nb-setting') as HTMLInputElement).value.trim();
    const rules = (document.getElementById('nb-rules') as HTMLTextAreaElement).value
      .split('\n').map((r) => r.trim()).filter(Boolean);
    if (!title) { msg.textContent = 'Title is required.'; return; }
    try {
      const r = (await apiPost('/api/story/bible', { title, genre, setting, rules })) as { story_id: number };
      window.location.href = `${BASE}/bible?story=${r.story_id}`;
    } catch (e) {
      msg.textContent = e instanceof Error ? e.message : 'Create failed.';
    }
  });
  document.getElementById('open-bible')!.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const id = (document.getElementById('ob-id') as HTMLInputElement).value.trim();
    if (id) window.location.href = `${BASE}/bible?story=${encodeURIComponent(id)}`;
  });
</script>
</BaseLayout>
